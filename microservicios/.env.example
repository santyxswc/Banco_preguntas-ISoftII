GATEWAY_PORT=8080
FRONTEND_ORIGINS=*

QUESTION_SERVICE_PORT=8081
VALIDATION_SERVICE_PORT=8082
USER_SERVICE_PORT=8083
LIFECYCLE_SERVICE_PORT=8084
REVIEW_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086

QUESTION_SERVICE_URL=http://localhost:8081
QUESTION_SERVICE_URL_2=http://localhost:8091
QUESTION_SERVICE_ROUTE=http://localhost:8081
VALIDATION_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8083
LIFECYCLE_SERVICE_URL=http://localhost:8084
REVIEW_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086

HTTP_CONNECT_TIMEOUT_MS=2000
HTTP_READ_TIMEOUT_MS=3000

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_RETRY_MAX_ATTEMPTS=3

USER_DB_URL=jdbc:h2:file:./data/user-db;AUTO_SERVER=TRUE
USER_DB_USER=sa
USER_DB_PASSWORD=

# RNF #1: Keycloak (proveedor de identidad). El gateway valida los JWT que emite este realm.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=banco-preguntas
KEYCLOAK_ISSUER=http://localhost:8180/realms/banco-preguntas
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
IDENTITY_CACHE_TTL_SECONDS=60

QUESTION_DB_URL=jdbc:h2:file:./data/question-db;AUTO_SERVER=TRUE
QUESTION_DB_USER=sa
QUESTION_DB_PASSWORD=

LIFECYCLE_DB_URL=jdbc:h2:file:./data/lifecycle-db;AUTO_SERVER=TRUE
LIFECYCLE_DB_USER=sa
LIFECYCLE_DB_PASSWORD=

REVIEW_DB_URL=jdbc:h2:file:./data/review-db;AUTO_SERVER=TRUE
REVIEW_DB_USER=sa
REVIEW_DB_PASSWORD=
REVIEW_DB_DDL=update

NOTIFICATIONS_ADMIN_ID=1

# RNF #3: solo para Docker Compose (docker compose up -d --build).
# Dentro de la red de Compose las URL y las bases de datos ya vienen fijadas en docker-compose.yml;
# aquí solo se cambian los puertos publicados en el equipo y las contraseñas.
# GATEWAY_PORT (arriba) también define el puerto publicado del gateway: si el 8080 está ocupado, use p. ej. 8088.
FRONTEND_PORT=5173
RABBITMQ_AMQP_PORT=5672
RABBITMQ_CONSOLE_PORT=15672
DB_PASSWORD=banco_preguntas
QUESTIONS_DEMO_DATA=true
EMAIL_MODE=console
