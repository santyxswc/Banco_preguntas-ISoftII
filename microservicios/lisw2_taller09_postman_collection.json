                "notifications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Se generó al menos una notificación asíncrona', function () {",
                  "    var list = pm.response.json();",
                  "    pm.expect(list.length).to.be.above(0);",
